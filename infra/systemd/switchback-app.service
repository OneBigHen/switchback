[Unit]
Description=Switchback motorcycle planner
After=network-online.target switchback-router.service
Wants=network-online.target switchback-router.service

[Service]
Type=simple
User=switchback
Group=switchback
WorkingDirectory=/opt/switchback
Environment=NODE_ENV=production
EnvironmentFile=-/etc/switchback/switchback.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3100
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/switchback/.next/cache

[Install]
WantedBy=multi-user.target
