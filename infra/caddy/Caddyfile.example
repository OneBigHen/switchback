{
	# Local-only deployments do not need an ACME account.
	# Set an email here if you replace `tls internal` with public ACME certificates.
	admin 127.0.0.1:2019
}

{$SWITCHBACK_HOST:switchback.home.arpa} {
	tls internal
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), screen-wake-lock=(self)"
		X-Frame-Options DENY
	}

	# Next owns the browser/API boundary. GraphHopper is deliberately not proxied.
	reverse_proxy 127.0.0.1:3100 {
		transport http {
			dial_timeout 5s
			response_header_timeout 95s
		}
	}

	log {
		output file /var/log/caddy/switchback-access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format console
	}
}
