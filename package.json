{
  "name": "switchback-moto",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=desktop-chromium --project=mobile-safari --project=mobile-landscape-wide --project=mobile-landscape-narrow",
    "test:e2e:mobile-qa": "tsx scripts/qa/mobile-qa-orchestrator.ts",
    "test:e2e:mobile-qa:prepare": "MOBILE_QA_EXPECTED_PROJECTS=webkit-prepare playwright test --config=playwright.mobile.config.ts --project=webkit-prepare",
    "test:e2e:mobile-qa:expanded": "MOBILE_QA_EXPECTED_PROJECTS=webkit-small,webkit-standard,webkit-large,webkit-standard-landscape,chromium-standard playwright test --config=playwright.mobile.config.ts --project=webkit-small --project=webkit-standard --project=webkit-large --project=webkit-standard-landscape --project=chromium-standard",
    "report:mobile-qa": "tsx scripts/qa/report-mobile-qa.ts",
    "test:e2e:critical": "playwright test --project=critical-chromium --project=critical-webkit",
    "test:e2e:real-router": "SWITCHBACK_E2E_MODE=real-router VALHALLA_URL= VALHALLA_ELEVATION_URL= playwright test --project=real-router",
    "test:e2e:pwa": "SWITCHBACK_E2E_MODE=pwa playwright test --project=pwa",
    "test:e2e:memory-soak": "playwright test tests/e2e/memory-soak.spec.ts --project=memory-soak",
    "test:live-smoke": "node scripts/qa/run-live-smoke.mjs",
    "qa": "npm run qa:quick",
    "qa:quick": "node scripts/qa/quick.mjs",
    "qa:pr": "npm run lint && npm run typecheck && npm test && npm run test:e2e:critical && npm run build",
    "quality:summary": "node scripts/qa/summarize-results.mjs",
    "routing:import": "scripts/graphhopper.sh import",
    "routing:start": "scripts/graphhopper.sh start",
    "data:bootstrap": "scripts/bootstrap-data.sh",
    "offline:build:pa": "node --max-old-space-size=2048 scripts/build-offline-v2.mjs data/pennsylvania-motorcycle.osm.pbf data/offline-regions pennsylvania Pennsylvania",
    "offline:build:nj": "node --max-old-space-size=2048 scripts/build-offline-v2.mjs data/new-jersey-latest.osm.pbf data/offline-regions new-jersey 'New Jersey'",
    "gpx:import-projects": "tsx scripts/import-project-gpx.ts",
    "validate:live": "node scripts/validate-live.mjs",
    "validate:curvature": "node scripts/validate-curvature-live.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "benchmark:routing": "tsx scripts/benchmark-routing.mjs",
    "atlas:build": "node scripts/build-route-atlas.mjs",
    "doctor": "react-doctor --no-telemetry"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/oswald": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.0",
    "@turf/along": "^7.3.5",
    "@turf/bearing": "^7.3.5",
    "@turf/boolean-point-in-polygon": "^7.3.5",
    "@turf/distance": "^7.3.5",
    "better-sqlite3": "12.11.1",
    "dexie": "4.4.4",
    "linkedom": "^0.18.13",
    "mapbox-gl": "3.28.1",
    "maplibre-gl": "5.24.0",
    "next": "16.3.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "suncalc": "^2.0.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "29.1.1",
    "postcss": "8.5.23",
    "react-doctor": "0.9.12",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
