# Server-only provider endpoints. Keep routing engines on loopback.
GRAPHHOPPER_URL=http://127.0.0.1:8989
PHOTON_URL=https://photon.komoot.io/api/

# Rate limiting keys on the caller's IP. Behind Cloudflare, set this to "1"
# so the trusted cf-connecting-ip header is used (keep the origin firewalled
# to Cloudflare IPs). Without a reverse proxy that owns X-Real-IP /
# X-Forwarded-For (see infra/caddy/Caddyfile.example), per-IP limits are
# spoofable and should be treated as best-effort.
# TRUST_CF_CONNECTING_IP=

# Optional supplemental/fallback router for supported point-to-point requests.
# GraphHopper remains primary; Adventure and native round trips stay on
# GraphHopper because their semantics are not interchangeable.
# VALHALLA_URL=http://127.0.0.1:8002

# Optional elevation source, independent from Valhalla routing. When
# configured, Switchback calls /height for ascent/descent and preserves route
# geometry if elevation is unavailable. The optional pinned runtime and its
# PA/NJ tile/elevation runbook live at infra/valhalla/compose.yml and
# infra/valhalla/README.md; enable these variables only after its local checks.
# VALHALLA_ELEVATION_URL=http://127.0.0.1:8002

# Geocoder coverage bounds. Override to restrict place search bias to a
# different region. Format: south,west,north,east (decimal degrees).
# Defaults to Pennsylvania/New Jersey coverage. Example for New England:
# SWITCHBACK_GEOCODER_BBOX=41.0,-73.7,47.5,-66.9
# SWITCHBACK_GEOCODER_REGION=massachusetts

# Optional natural-language ride interpretation. Leave the key blank to use
# Switchback's deterministic local parser without making an OpenRouter request.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional ride advisor (ADR 0023). Setting OPENROUTER_API_KEY above also turns
# on the conversational "second opinion" co-pilot in the planner.
#
# DATA EGRESS: with the advisor on, the route's sampled geometry, the candidate
# metrics, and the rider's own messages are sent to OpenRouter. Leave
# OPENROUTER_API_KEY blank to keep every ride on this machine — the planner is
# fully functional without it and the advisor UI does not render at all.
#
# Model for advisor turns only; ride-intent parsing keeps OPENROUTER_MODEL.
# OPENROUTER_ADVISOR_MODEL=google/gemini-2.5-flash-lite

# Optional: let the advisor consult Grounding with Google Maps for place
# character and freshness. OFF by default, and the key below is not enough on
# its own — this flag is a separate, deliberate decision because Maps grounding
# is billed per query and carries display-attribution obligations. Switchback
# never consumes its directions or travel times: route choice stays with
# GraphHopper/Valhalla. See docs/adr/0023-route-advisor.md.
# GOOGLE_MAPS_GROUNDING=1

# Optional server-only Google Places Text Search and stop ideas. Destination
# searches are biased from the resolved route origin and fall back to Photon on
# empty/error responses. Stop ideas use rider-fit ranking. Do not expose this
# key through a NEXT_PUBLIC_ variable.
GOOGLE_MAPS_API_KEY=
# Optional server-only web research for an explicit "Research road & stop
# ideas" request. Keep this separate from routing and place search.
YOU_API_KEY=

# Where the 7-day corridor-hint cache lives (used by /api/ride-corridors and
# read by the timeboxed destination planner). Defaults to the repo data dir.
CORRIDOR_CACHE_PATH=

# Identify this self-hosted instance to the National Weather Service API.
# Replace the example contact before deploying outside local development.
NWS_USER_AGENT="Switchback/0.2 (your-email@example.com)"

# Optional curvature overlay. Use an absolute path for a systemd deployment.
CURVATURE_DB_PATH=data/segments.db

# Optional server-side project GPX catalog. Imported/saved browser routes still
# live in IndexedDB on each device.
GPX_LIBRARY_PATH=data/gpx-library

# Optional route-centered community and private sync stores. Keep both files
# outside the web root and do not commit the runtime databases.
COMMUNITY_DB_PATH=data/community.sqlite
SYNC_DB_PATH=data/sync.sqlite
SWITCHBACK_SESSION_SECRET=
# Optional passkey identity configuration. Set both values for production;
# they must match the public HTTPS hostname and exact origin.
# SWITCHBACK_WEBAUTHN_RP_ID=rides.example.com
# SWITCHBACK_WEBAUTHN_ORIGIN=https://rides.example.com
# SWITCHBACK_WEBAUTHN_RP_NAME=Switchback

# Optional verified canonical-segment + RIG corridor document for Free Ride.
# Without this artifact Free Ride remains honestly unavailable; it never falls
# back to curvature rows or straight-line guesses.
# FREE_RIDE_RIG_PATH=data/free-ride-rig.json

# Browser-visible MapLibre "Clean" style. This value is compiled into the client
# at build time; Explorer and Night use their bundled OpenFreeMap style URLs.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# --- Premium map renderer (ADR 0015) ---
# Mapbox GL JS v3 with Mapbox Standard is the primary online renderer. Both
# values are compiled into the client at build time.
#
# The rollout flag is temporary: phase 4 replaces it with the server-declared
# capability payload (ADR 0021). Leave it unset to keep the MapLibre renderer.
# NEXT_PUBLIC_SWITCHBACK_PREMIUM_MAPBOX=true
#
# A browser-authorized public Mapbox token (`pk.`), URL-restricted to this
# deployment's origins. Never a secret `sk.` token — GL JS does not use one.
# Without a token the premium renderer stays off rather than rendering a blank
# canvas.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional shell-only overrides for `npm run data:bootstrap`.
# SWITCHBACK_PBF_URL=https://download.geofabrik.de/north-america/us/pennsylvania-latest.osm.pbf
# SWITCHBACK_GRAPHHOPPER_JAR_URL=https://repo1.maven.org/maven2/com/graphhopper/graphhopper-web/11.0/graphhopper-web-11.0.jar
