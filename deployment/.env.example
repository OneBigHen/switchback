SWITCHBACK_DOMAIN=ride.example.com
SWITCHBACK_TAG=2026.08.12-immutable
NODE_ENV=production
SWITCHBACK_SESSION_SECRET=
TRUST_CF_CONNECTING_IP=0
SWITCHBACK_WEBAUTHN_RP_ID=ride.example.com
SWITCHBACK_WEBAUTHN_ORIGIN=https://ride.example.com
SWITCHBACK_WEBAUTHN_RP_NAME=Switchback
# Comma-separated identity ids allowed to review or moderate public reports.
SWITCHBACK_COMMUNITY_OPERATOR_IDS=
# Preferred absolute host path for backup/restore. Leave empty only when the
# compose-scoped /data mount can be resolved unambiguously.
SWITCHBACK_DATA_ROOT=
SWITCHBACK_GRAPH_DATA_ROOT=/var/lib/switchback/graph
GRAPHHOPPER_URL=http://graphhopper:8989
COMMUNITY_DB_PATH=/data/app/community.sqlite
SYNC_DB_PATH=/data/app/sync.sqlite
